{% comment %}
  Petrichor Atelier — Hero Banner
  Mode is automatic: no slide blocks → single image; slide blocks present → carousel.
{% endcomment %}

{%- liquid
  assign is_carousel = section.blocks.size > 0
  assign brightness  = 100 | minus: section.settings.overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .pa-hero {
    min-height: {% if section.settings.full_height %}100svh{% else %}{{ section.settings.min_height }}px{% endif %};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .pa-hero {
      min-height: {% if section.settings.full_height %}100svh{% else %}{{ section.settings.min_height_mobile }}px{% endif %};
    }
  }
  {%- if section.index == 1 -%}
  #shopify-section-{{ section.id }} {
    margin-top: calc(-1 * var(--pa-header-height, 80px));
  }
  {%- endif -%}
  {%- unless is_carousel -%}
  #shopify-section-{{ section.id }} .pa-hero__img {
    object-position: {{ section.settings.image_position }};
  }
  {%- endunless -%}
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .pa-hero {
    position: relative;
    overflow: hidden;
    background: var(--pa-pine);
    color: var(--pa-ivory);
    display: flex;
    align-items: flex-end;
  }

  /* ── Media layer ── */
  #shopify-section-{{ section.id }} .pa-hero__media {
    position: absolute;
    inset: 0;
  }
  #shopify-section-{{ section.id }} .pa-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Atmosphere ── */
  #shopify-section-{{ section.id }} .pa-hero__atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 40%, rgba(167, 188, 175, 0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 80% 90%, rgba(29, 29, 27, 0.55)   0%, transparent 50%),
      linear-gradient(180deg, rgba(48, 75, 61, 0) 0%, rgba(29, 29, 27, 0.45) 100%);
    pointer-events: none;
  }

  /* ── Content ── */
  #shopify-section-{{ section.id }} .pa-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-content, 1280px);
    margin: 0 auto;
    padding: 160px var(--gutter, 40px) 80px;
  }

  #shopify-section-{{ section.id }} .pa-hero__eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: rgba(249, 248, 244, 0.65);
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .pa-hero__heading {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(72px, 11vw, 168px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--pa-ivory);
    text-wrap: balance;
    max-width: 14ch;
  }
  #shopify-section-{{ section.id }} .pa-hero__heading em,
  #shopify-section-{{ section.id }} .pa-hero__heading i {
    font-family: var(--font-editorial);
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .pa-hero__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 56px;
    gap: 40px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pa-hero__sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.4;
    margin: 0;
    max-width: 460px;
    color: rgba(249, 248, 244, 0.85);
  }

  #shopify-section-{{ section.id }} .pa-hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    flex-shrink: 0;
  }

  /* Primary CTA — accent (mint) */
  #shopify-section-{{ section.id }} .pa-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--t-cta);
    letter-spacing: var(--ls-cta);
    text-transform: uppercase;
    color: var(--pa-ink);
    background: var(--pa-mint);
    text-decoration: none;
    border: none;
    padding: 14px 24px;
    white-space: nowrap;
    transition: background var(--dur-base) var(--ease-soft);
  }
  #shopify-section-{{ section.id }} .pa-hero__cta:hover {
    background: color-mix(in srgb, var(--pa-mint) 82%, var(--pa-ink));
  }
  #shopify-section-{{ section.id }} .pa-hero__cta:focus-visible {
    outline: 2px solid var(--pa-mint);
    outline-offset: 3px;
  }

  /* Secondary CTA — mint underline */
  #shopify-section-{{ section.id }} .pa-hero__cta--secondary {
    background: none;
    border: none;
    padding: 0 0 3px;
    color: var(--pa-mint);
    border-bottom: 1px solid color-mix(in srgb, var(--pa-mint) 45%, transparent);
    transition: border-color var(--dur-base) var(--ease-soft);
  }
  #shopify-section-{{ section.id }} .pa-hero__cta--secondary:hover {
    background: none;
    color: var(--pa-mint);
    border-color: var(--pa-mint);
  }

  /* ── Carousel slides ── */
  #shopify-section-{{ section.id }} .pa-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms ease;
    display: flex;
    align-items: flex-end;
  }
  #shopify-section-{{ section.id }} .pa-hero__slide.is-active {
    opacity: 1;
  }

  /* ── Carousel dots ── */
  #shopify-section-{{ section.id }} .pa-hero__dots {
    position: absolute;
    bottom: 36px;
    right: var(--gutter, 40px);
    display: flex;
    gap: 8px;
    align-items: center;
    z-index: 3;
  }
  #shopify-section-{{ section.id }} .pa-hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(249, 248, 244, 0.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 240ms ease, transform 240ms ease;
  }
  #shopify-section-{{ section.id }} .pa-hero__dot.is-active {
    background: var(--pa-ivory);
    transform: scale(1.4);
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .pa-hero {
      align-items: flex-start;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .pa-hero__slide {
      align-items: flex-start;
    }
    #shopify-section-{{ section.id }} .pa-hero__inner {
      padding: calc(var(--pa-header-height, 80px) + 36px) var(--gutter-mobile, 20px) 48px;
    }
    #shopify-section-{{ section.id }} .pa-hero__heading {
      max-width: 100%;
    }
    #shopify-section-{{ section.id }} .pa-hero__foot {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 36px;
      gap: 24px;
    }
    #shopify-section-{{ section.id }} .pa-hero__dots {
      bottom: 20px;
      right: var(--gutter-mobile, 20px);
    }
  }
</style>

{%- comment -%}Tell sticky header to start transparent{%- endcomment -%}
<script>
  (function () {
    function applyTransparent() {
      var h = document.getElementById('pa-site-header');
      if (h) h.classList.add('pa-header--transparent');
    }
    applyTransparent();
    document.addEventListener('DOMContentLoaded', applyTransparent);
  })();
</script>

{%- comment -%}── CONTENT SNIPPET — reused by both single and carousel ──{%- endcomment -%}
{%- capture hero_content -%}
  {%- assign s_eyebrow = eyebrow_out -%}
  {%- assign s_heading = heading_out -%}
  {%- assign s_sub     = sub_out -%}
  {%- assign s_cta_l   = cta_label_out -%}
  {%- assign s_cta_u   = cta_url_out -%}
  {%- assign s_cta2_l  = cta2_label_out -%}
  {%- assign s_cta2_u  = cta2_url_out -%}
{%- endcapture -%}

<div class="pa-hero" id="pa-hero-{{ section.id }}">

  {%- if is_carousel -%}

    {%- comment -%}── CAROUSEL MODE ──{%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign sl_heading   = block.settings.heading
        if sl_heading == blank
          assign sl_heading = section.settings.heading
        endif
        assign sl_sub       = block.settings.subheading
        if sl_sub == blank
          assign sl_sub = section.settings.subheading
        endif
        assign sl_eyebrow   = block.settings.eyebrow
        if sl_eyebrow == blank
          assign sl_eyebrow = section.settings.eyebrow
        endif
        assign sl_cta_l     = block.settings.cta_label
        if sl_cta_l == blank
          assign sl_cta_l = section.settings.cta_label
        endif
        assign sl_cta_u     = block.settings.cta_url
        if sl_cta_u == blank
          assign sl_cta_u = section.settings.cta_url | default: routes.collections_url
        endif
        assign sl_cta2_l    = block.settings.cta_2_label
        if sl_cta2_l == blank
          assign sl_cta2_l = section.settings.cta_2_label
        endif
        assign sl_cta2_u    = block.settings.cta_2_url
        if sl_cta2_u == blank
          assign sl_cta2_u = section.settings.cta_2_url
        endif
        assign sl_brightness = 100 | minus: section.settings.overlay_opacity | divided_by: 100.0
      -%}

      <div class="pa-hero__slide{% if forloop.first %} is-active{% endif %}"
           data-index="{{ forloop.index0 }}"
           {{ block.shopify_attributes }}>

        {%- if block.settings.image != blank -%}
          <div class="pa-hero__media" style="filter: brightness({{ sl_brightness }});">
            {{
              block.settings.image
              | image_url: width: 3840
              | image_tag:
                class: 'pa-hero__img',
                sizes: '100vw',
                widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
                loading: forloop.first | then: 'eager' | default: 'lazy',
                style: 'object-position: ' | append: block.settings.image_position,
                alt: block.settings.image.alt | default: shop.name | escape
            }}
          </div>
        {%- endif -%}

        <div class="pa-hero__atmosphere" aria-hidden="true"></div>

        <div class="pa-hero__inner">
          {%- if sl_eyebrow != blank -%}
            <span class="pa-hero__eyebrow">{{ sl_eyebrow | escape }}</span>
          {%- endif -%}
          {%- if sl_heading != blank -%}
            <h2 class="pa-hero__heading">{{ sl_heading }}</h2>
          {%- endif -%}
          <div class="pa-hero__foot">
            {%- if sl_sub != blank -%}
              <p class="pa-hero__sub">{{ sl_sub | escape }}</p>
            {%- endif -%}
            {%- if sl_cta_l != blank or sl_cta2_l != blank -%}
              <div class="pa-hero__ctas">
                {%- if sl_cta_l != blank -%}
                  <a href="{{ sl_cta_u }}" class="pa-hero__cta">
                    {{ sl_cta_l | escape }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if sl_cta2_l != blank and sl_cta2_u != blank -%}
                  <a href="{{ sl_cta2_u }}" class="pa-hero__cta pa-hero__cta--secondary">
                    {{ sl_cta2_l | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <div class="pa-hero__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <button class="pa-hero__dot{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-target="{{ forloop.index0 }}"
                  aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  {%- else -%}

    {%- comment -%}── SINGLE MODE ──{%- endcomment -%}
    {%- if section.settings.image != blank -%}
      <div class="pa-hero__media" style="filter: brightness({{ brightness }});">
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w,
                      {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
              sizes="100vw">
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
              class: 'pa-hero__img',
              sizes: '100vw',
              widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
              fetchpriority: 'high',
              alt: section.settings.image.alt | default: shop.name | escape
          }}
        </picture>
      </div>
    {%- endif -%}

    <div class="pa-hero__atmosphere" aria-hidden="true"></div>

    <div class="pa-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pa-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="pa-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      <div class="pa-hero__foot">
        {%- if section.settings.subheading != blank -%}
          <p class="pa-hero__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank or section.settings.cta_2_label != blank -%}
          <div class="pa-hero__ctas">
            {%- if section.settings.cta_label != blank -%}
              <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="pa-hero__cta">
                {{ section.settings.cta_label | escape }}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.cta_2_label != blank and section.settings.cta_2_url != blank -%}
              <a href="{{ section.settings.cta_2_url }}" class="pa-hero__cta pa-hero__cta--secondary">
                {{ section.settings.cta_2_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  {%- endif -%}

</div>

{%- if is_carousel and section.blocks.size > 1 -%}
<script>
  (function () {
    var hero    = document.getElementById('pa-hero-{{ section.id }}');
    if (!hero) return;
    var slides  = Array.from(hero.querySelectorAll('.pa-hero__slide'));
    var dots    = Array.from(hero.querySelectorAll('.pa-hero__dot'));
    var speed   = {{ section.settings.autoplay_speed | times: 1000 }};
    var current = 0;
    var timer   = null;

    function goTo(index) {
      slides[current].classList.remove('is-active');
      if (dots[current]) dots[current].classList.remove('is-active');
      current = ((index % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');
    }

    function start() { timer = setInterval(function () { goTo(current + 1); }, speed); }
    function stop()  { clearInterval(timer); }

    start();
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin',    stop);
    hero.addEventListener('focusout',   start);

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () { stop(); goTo(i); start(); });
    });

    var touchStartX = null;
    hero.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    hero.addEventListener('touchend', function (e) {
      if (touchStartX === null) return;
      var dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 44) { stop(); goTo(dx < 0 ? current + 1 : current - 1); start(); }
      touchStartX = null;
    }, { passive: true });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "PA — Hero Banner",
  "tag": "section",
  "class": "section-pa-hero",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Background image",
      "info": "Used as a static image. Ignored when slide blocks are added below."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)",
      "info": "Replaces the desktop image on screens narrower than 750px. Use for art-directed crops or a pre-composed split."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Focal point",
      "options": [
        { "value": "center center", "label": "Centre" },
        { "value": "top center",    "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left",   "label": "Left" },
        { "value": "center right",  "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image darkness",
      "default": 40,
      "info": "Applies to all slides in carousel mode."
    },
    {
      "type": "header",
      "content": "Carousel",
      "info": "Only applies when slide blocks are added in the blocks panel below."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Pauses on hover and touch."
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full viewport height",
      "default": false
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 480,
      "max": 1080,
      "step": 40,
      "unit": "px",
      "label": "Minimum height — desktop",
      "default": 720
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 320,
      "max": 720,
      "step": 40,
      "unit": "px",
      "label": "Minimum height — mobile",
      "default": 560
    },
    {
      "type": "header",
      "content": "Default content",
      "info": "Used on single image. In carousel mode, used as fallback when a slide has no content set."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Petrichor Atelier · Sydney"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Fragrance <em>deeply</em> <em>felt</em>.",
      "info": "Use italic in the editor for the editorial serif style."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A curation of rare houses, brought home to Australia — for the people who want to feel something rare."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Step inside"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary CTA (optional)"
    },
    {
      "type": "text",
      "id": "cta_2_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_2_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Focal point",
          "options": [
            { "value": "center center", "label": "Centre" },
            { "value": "top center",    "label": "Top" },
            { "value": "bottom center", "label": "Bottom" },
            { "value": "center left",   "label": "Left" },
            { "value": "center right",  "label": "Right" }
          ],
          "default": "center center"
        },
        {
          "type": "header",
          "content": "Content override",
          "info": "Leave blank to use the section's default content."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Primary button label"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "cta_2_label",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "cta_2_url",
          "label": "Secondary button link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PA — Hero Banner"
    }
  ]
}
{% endschema %}
